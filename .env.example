# Copy to .env and fill in. Never commit the real .env.

# --- Core ---
PORT=4400
# Public base URL this service is reachable at (needed for OAuth callbacks and for
# platforms that fetch media by URL, e.g. Instagram/TikTok pull-from-URL). Must be
# https in production - OAuth callbacks and platform media fetches require it.
PUBLIC_URL=http://localhost:4400
# 32-byte hex key used to encrypt stored platform tokens at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
# Simple shared-secret for the dashboard (no user accounts - single brand, single operator).
DASHBOARD_PASSWORD=

# --- YouTube (Google Cloud Console -> APIs & Services -> Credentials) ---
# Enable "YouTube Data API v3" on the project first.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- Instagram (Meta for Developers -> your app -> Instagram Graph API) ---
# Needs an Instagram Business/Creator account linked to a Facebook Page, and the
# app's Instagram product configured with that Page.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# --- TikTok (TikTok for Developers -> your app -> Content Posting API) ---
# Unaudited apps can only publish as SELF_ONLY (private) - see README. Set to
# "true" only once TikTok has approved the app for public posting.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_AUDITED=false
